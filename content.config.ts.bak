// ============================================================
//  Stelarith · Nuxt Content 集合定义
//  与 Astro 版 src/content.config.ts 字段保持一致
// ============================================================
import { defineCollection, defineContentConfig, z } from "@nuxt/content";

export default defineContentConfig({
  collections: {
    // 文章
    posts: defineCollection({
      type: "page",
      schema: z.object({
        title: z.string(),
        description: z.string().optional(),
        pubDate: z.coerce.date(),
        updatedDate: z.coerce.date().optional(),
        draft: z.boolean().default(false),
        tags: z.array(z.string()).default([]),
        layout: z.enum(["default", "wide"]).default("default"),
      }),
    }),

    // 项目
    projects: defineCollection({
      type: "page",
      schema: z.object({
        title: z.string(),
        description: z.string().optional(),
        pubDate: z.coerce.date(),
        updatedDate: z.coerce.date().optional(),
        draft: z.boolean().default(false),
        tags: z.array(z.string()).default([]),
        layout: z.enum(["default", "wide"]).default("default"),
        status: z.enum(["active", "archived", "idea"]).default("idea"),
        repo: z.string().url().optional(),
        demo: z.string().url().optional(),
      }),
    }),

    // 笔记
    notes: defineCollection({
      type: "page",
      schema: z.object({
        title: z.string(),
        description: z.string().optional(),
        pubDate: z.coerce.date(),
        updatedDate: z.coerce.date().optional(),
        draft: z.boolean().default(false),
        tags: z.array(z.string()).default([]),
        layout: z.enum(["default", "wide"]).default("default"),
      }),
    }),

    // 友链（data）
    links: defineCollection({
      type: "data",
      schema: z.object({
        name: z.string(),
        url: z.string().url(),
        description: z.string().optional(),
        avatar: z.union([z.string().url(), z.literal("")]).optional(),
      }),
    }),

    // 图库（data）
    gallery: defineCollection({
      type: "data",
      schema: z.object({
        title: z.string().optional(),
        src: z.string(),
        alt: z.string().optional(),
        width: z.number().optional(),
        height: z.number().optional(),
        date: z.coerce.date().optional(),
        tags: z.array(z.string()).default([]),
      }),
    }),

    // 文档
    docs: defineCollection({
      type: "page",
      schema: z.object({
        title: z.string(),
        description: z.string().optional(),
        group: z.string().default("通用"),
        order: z.number().default(0),
        draft: z.boolean().default(false),
        updatedDate: z.coerce.date().optional(),
      }),
    }),

    // 瞬间
    moments: defineCollection({
      type: "page",
      schema: z.object({
        title: z.string().optional(),
        pubDate: z.coerce.date(),
        draft: z.boolean().default(false),
        type: z.enum(["text", "image", "link"]).default("text"),
        images: z.array(z.string()).default([]),
        linkUrl: z.string().url().optional(),
        linkTitle: z.string().optional(),
        mood: z.string().optional(),
      }),
    }),

    // 装备（data）
    gears: defineCollection({
      type: "data",
      schema: z.object({
        name: z.string(),
        category: z.string().default("其他"),
        description: z.string().optional(),
        image: z.string().optional(),
        url: z.string().url().optional(),
        order: z.number().default(0),
      }),
    }),

    // 大事记
    milestones: defineCollection({
      type: "page",
      schema: z.object({
        title: z.string(),
        date: z.coerce.date(),
        type: z.enum(["milestone", "project", "note"]).default("milestone"),
        draft: z.boolean().default(false),
      }),
    }),
  },
});
